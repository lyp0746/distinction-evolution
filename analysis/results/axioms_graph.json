    "axiom_5_separation_completeness": {
      "status": "有定理（本脚本）",
      "theorem": "原子区分动作 = 谱投影 P_k；P_k 由谱唯一决定。每个 P_k 可唯一分解为 rank-1 原子 ⟺ 该特征值单重。故：原子分解唯一 ⟺ 谱为单谱（所有特征值互异）。"
    },
    "axiom_6_standardization": {
      "status": "不适用",
      "reason": "有限图无超有限结构。"
    }
